features
	F0 
		optional
			F1 {Enabled true, Capacity -2}
				optional
					F2 {Enabled true}
						optional
							F3 {Enabled true}
								optional
									F4 {Enabled true, Capacity 2}
constraints
	F1.Enabled => F2.Enabled
	F1.Enabled <=> F3.Enabled
	F4.Enabled & ! F2.Enabled
	F3.Enabled => ! F1.Enabled
	F3.Enabled => ! F2.Enabled